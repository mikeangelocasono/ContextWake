{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextwake.invalid/schemas/awhf-1.1.0.schema.json",
  "title": "Agent Workspace Handoff Format 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "created_at", "source_tool", "source", "checkpoint_id", "workspace", "objective", "content_files", "redactions", "security_flags"],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "handoff_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "source_tool": { "type": "string", "minLength": 1, "maxLength": 256 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "model_provider_id", "model", "profile_id", "session_id"],
      "properties": {
        "agent_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "model_provider_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "model": { "type": ["string", "null"], "maxLength": 256 },
        "profile_id": { "type": ["string", "null"], "format": "uuid" },
        "session_id": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "checkpoint_id": { "type": "string", "format": "uuid" },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "path_fingerprint", "branch", "commit"],
      "properties": {
        "display_name": { "type": "string", "maxLength": 256 },
        "path_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "branch": { "type": ["string", "null"], "maxLength": 1024 },
        "commit": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "objective": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "content_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "media_type"],
        "properties": {
          "path": { "type": "string", "not": { "pattern": "(^/|^\\\\|\\.\\.)" } },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "media_type": { "enum": ["text/markdown", "application/json"] }
        }
      }
    },
    "redactions": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "security_flags": { "type": "array", "items": { "type": "string", "maxLength": 256 }, "uniqueItems": true },
    "extensions": { "type": "object" }
  }
}
